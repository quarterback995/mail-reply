# ===== 固定 API 配置 =====
# 设置后，前端无需每次配置，直接使用此 API
# 留空则需要在前端设置页面配置

# API 提供商: openai / anthropic / deepseek / moonshot / zhipu / xiaomi / custom
API_PROVIDER=

# 模型名称
API_MODEL=

# API Key
API_KEY=

# API Base URL（留空使用提供商默认地址）
API_BASE_URL=

# ===== 默认参数 =====
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=2000
