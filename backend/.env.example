# API_6_PROVIDER=zhipu
# API_6_KEY=your-key-here
# API_6_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# API_6_MODEL_FAST=glm-4-flash
# API_6_MODEL_BALANCED=glm-4
# API_6_MODEL_QUALITY=glm-4-plus

# ============================================================
# 全局默认参数（当 API 条目未指定三档模型时使用）
# ============================================================
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=20000

# ============================================================
# 翻译服务配置
# ============================================================
# 百度翻译（免费 5万次/月）：https://fanyi-api.baidu.com/product/113
# 申请步骤：注册 → 开放平台 → 创建应用 → 获取 APP_ID 和 SECRET_KEY
BAIDU_TRANS_APP_ID=your_app_id
BAIDU_TRANS_SECRET=your_secret_key
