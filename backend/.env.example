# ============================================================
# 多 API 配置（前端可直接选择，无需手动填写参数）
# ============================================================
# 编号从 1 开始，支持配置任意多个 API
# 每个 API 包含: NAME(显示名称), PROVIDER, KEY, BASE_URL
# 可选: MODEL_FAST, MODEL_BALANCED, MODEL_QUALITY (覆盖全局三档模型)
#
# 留空则不显示该条目

# --- API 1: OpenAI ---
API_1_NAME=OpenAI GPT
API_1_PROVIDER=openai
API_1_KEY=sk-your-key-here
API_1_BASE_URL=https://api.openai.com/v1
API_1_MODEL_FAST=gpt-4o-mini
API_1_MODEL_BALANCED=gpt-4o
API_1_MODEL_QUALITY=gpt-4-turbo

# --- API 2: DeepSeek ---
API_2_NAME=DeepSeek
API_2_PROVIDER=deepseek
API_2_KEY=sk-your-key-here
API_2_BASE_URL=https://api.deepseek.com
API_2_MODEL_FAST=deepseek-chat
API_2_MODEL_BALANCED=deepseek-chat
API_2_MODEL_QUALITY=deepseek-reasoner

# --- API 3: Anthropic Claude ---
API_3_NAME=Claude
API_3_PROVIDER=anthropic
API_3_KEY=sk-ant-your-key-here
API_3_BASE_URL=https://api.anthropic.com
API_3_MODEL_FAST=claude-3-5-haiku-20241022
API_3_MODEL_BALANCED=claude-3-5-sonnet-20241022
API_3_MODEL_QUALITY=claude-3-opus-20240229

# --- API 4: 通义千问 ---
API_4_NAME=通义千问
API_4_PROVIDER=qwen
API_4_KEY=sk-your-key-here
API_4_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
API_4_MODEL_FAST=qwen-turbo
API_4_MODEL_BALANCED=qwen-plus
API_4_MODEL_QUALITY=qwen-max

# --- API 5: 月之暗面 Moonshot ---
# API_5_NAME=Moonshot
# API_5_PROVIDER=moonshot
# API_5_KEY=sk-your-key-here
# API_5_BASE_URL=https://api.moonshot.cn/v1
